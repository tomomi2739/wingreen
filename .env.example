# WinGreen専用のNotionインテグレーショントークン
# https://www.notion.so/profile/integrations で作成した Internal Integration Secret
# ここだけが秘密情報。DB IDは config/periods.json（コミット対象）で管理する。
NOTION_TOKEN_WG=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 本番（Vercel）のアクセス制限用。ローカル開発では使われない。
# 未設定のままデプロイすると、サイト全体が503で停止する（誤って公開されるのを防ぐため）。
WG_PASSWORD=
WG_USER=wingreen
